{
  "action": {
    "default_popup": "popup.html",
    "default_title": "webai-hands"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "adapters/muse.js",
        "adapters/deepseek.js",
        "content.js"
      ],
      "matches": [
        "https://muse.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Give muse.ai hands on your computer — turn chat into action.",
  "host_permissions": [
    "https://muse.ai/*",
    "https://chat.deepseek.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "webai-hands",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "version": "0.5.17"
}
